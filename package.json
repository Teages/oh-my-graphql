{
  "name": "@teages/oh-my-graphql",
  "type": "module",
  "version": "0.1.4",
  "packageManager": "pnpm@10.6.3",
  "description": "Another simple GraphQL client, base on ofetch.",
  "license": "MIT",
  "repository": "Teages/oh-my-graphql",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "obuild",
    "dev": "vitest dev",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "prepack": "pnpm build",
    "play:prepare": "cd playground && pnpm prepare",
    "play": "jiti playground",
    "release": "pnpm test && changelogen --release && npm publish && git push --follow-tags",
    "test": "pnpm lint && pnpm test:types && pnpm test:unit",
    "test:types": "tsc --noEmit --skipLibCheck",
    "test:unit": "vitest run --coverage"
  },
  "dependencies": {
    "@0no-co/graphql.web": "^1.3.4",
    "defu": "^6.1.7",
    "ofetch": "^1.5.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@pothos/core": "^4.13.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.9.1",
    "gazania": "^0.15.4",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.22.0",
    "jiti": "2.7.0",
    "obuild": "^0.4.39",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
